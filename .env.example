# Telegram Bot Token (@BotFather'dan, /newbot orqali olinadi)
TELEGRAM_BOT_TOKEN=your_token_here

# Bot egasi(lari) - Telegram foydalanuvchi ID, vergul bilan ajratilgan.
# Bo'sh qoldirilsa, app/config/app.php'dagi standart qiymat ishlatiladi.
OWNER_IDS=8539436212

# Bot locale (en_US, pt_BR, es_ES)
BOT_LOCALE=en_US

# Debug mode
APP_DEBUG=false

# Public API and dashboard credentials
# Generate with: php -r "echo bin2hex(random_bytes(32));"
PUBLIC_API_TOKEN=replace_with_a_long_random_token
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
DASHBOARD_PASSWORD_HASH=replace_with_a_password_hash

# PostgreSQL is used when set; SQLite is used otherwise
# DATABASE_URL=postgresql://user:password@host:5432/database
