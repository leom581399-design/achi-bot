# BotFather'dan olingan token
BOT_TOKEN=123456789:AAA-your-token-here

# Bot super-adminlari (Telegram user ID, vergul bilan ajratilgan)
# Bularga botning barcha buyruqlari ochiq, guruh admini bo'lmasa ham
SUPER_ADMINS=123456789,987654321

# Har soatlik PDF hisobot yuboriladigan chat/kanal ID (ixtiyoriy, bo'sh qoldirish mumkin)
REPORT_CHAT_ID=

# Ma'lumotlar bazasi fayli
DB_PATH=achi_bot.db

# Hisobot va vaqtinchalik fayllar papkasi
REPORTS_DIR=reports

# CS2 (.skin/.oruzhiya) narx qidiruvini yoqish/o'chirish
# Narx manbasi: Skinport.com (rasmiy, ochiq API) + Steam (zaxira manba)
CS2_MARKET_ENABLED=true

# 1 AQSH dollari nechchi so'mga teng (CS2 narxlarini so'mga aylantirish
# uchun). Vaqti-vaqti bilan haqiqiy kursga moslab qo'lda yangilab turing.
USD_TO_UZS_RATE=12500
